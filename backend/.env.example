# Copy to backend/.env (gitignored). Used by FastAPI and `langgraph dev`.
#
# Any OpenAI Chat Completions compatible gateway works:
#   OpenAI      OPENAI_BASE_URL empty, OPENAI_MODEL=gpt-4o-mini
#   SiliconFlow OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#   DeepSeek    OPENAI_BASE_URL=https://api.deepseek.com
#   ModelScope  OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional. Empty = InMemorySaver. docker compose postgres:
# DATABASE_URL=postgresql://lg_user:lg_password@localhost:5432/lg_agent
DATABASE_URL=

# Deep Research workspace (FilesystemBackend /workspace/)
WORKSPACE_DIR=.workspace

# Optional. true = spawn official MCP filesystem + fetch at startup.
# Graph compile still works if the servers are missing.
MCP_ENABLED=false
